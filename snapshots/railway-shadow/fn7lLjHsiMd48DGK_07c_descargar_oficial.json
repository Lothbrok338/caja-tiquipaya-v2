      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst t = $('ENTRADA (Execute Workflow Trigger)').item.json;\nconst exactos = items.filter(function(it){ return it.json && it.json.name === t.nombre_archivo && it.json.id; });\nif (exactos.length > 1) {\n  throw new Error('ERROR_AMBIGUO_DESCARGA: se encontraron ' + exactos.length + ' archivos llamados \"' + t.nombre_archivo + '\" en la carpeta oficial (' + t.carpeta_id + '). No se descarga nada hasta resolver el duplicado manualmente.');\n}\nreturn [{ json: { encontrado: exactos.length === 1, file_id: exactos.length === 1 ? exactos[0].json.id : null } }];"
      }
