 exactos[0].json;\n  if (driveFileIdIngesta && encontrado.id !== driveFileIdIngesta) {\n    throw new Error('ERROR_FILEID_INGESTA_NO_COINCIDE: el fileId detectado en INGESTA (' + driveFileIdIngesta + ') no coincide con el fileId actual de \"' + archivoEsperado + '\" en 00_ENTRADA_CIERRES (' + encontrado.id + '). No se mueve nada.');\n}\nreturn [{ json: { encontrado_en_entrada: true, cierre_file_id: encontrado.id } }];\n}\nreturn [{ json: { encontrado_en_entrada: false, cierre_file_id: driveFileIdIngesta } }];"}},{"id":"30f68653-d8cb-4184-8cb9-3764c02134fc","name":"IF - Cierre encontrado en ENTRADA","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[3808,192],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"leftValue":"={{ $json.encontrado_en_entrada }}","operator":{"type":"boolean","operation":"true"},"rightValue":""}],"combinator":"and"}}},{"id":"a9e7ec63-782d-42a9-ac2d-7c4889f6acae","name":"USAR - Cierre pendiente de mover","type":"n8n-nodes-base.code","typeVersion":2,"position":[4256,96],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"return [{ json: { id: $json.cierre_file_id, ya_en_procesados: false } }];"}},{"id":"286f7b1a-8b15-4dc9-b5bf-5b72bfba38ce","name":"BUSCAR - Cierre por nombre en 03_PROCESADOS (retry)","type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[4032,288],"parameters":{"resource":"fileFolder","operation":"search","queryString":"={{ $('ENTRADA (Execute Workflow Trigger)').item.json.archivo_esperado }}","limit":10,"filter":{"folderId":{"__rl":true,"mode":"id","value":"1BkNC6lnonMM7YeWDKck-TM8WTyY2BJJP"},"whatToSearch":"files","includeTrashed":false},"options":{}},"alwaysOutputData":true,"credentials":{"googleDriveOAuth2Api":{"id":"aoEcEAFQQ38XcwZg","name":"Google Drive account"}}},{"id":"cb956f51-a01a-4b11-9584-e35bb04a2c80","name":"VERIFICAR - Cierre en PROCESADOS (retry)","type":"n8n-nodes-base.code","typeVersion":2,"position":[4256,288],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const items = $input.all();\nconst archivoEsperado = $('ENTRADA (Execute Workflow Trigger)').item.json.archivo_esperado;\nconst exactos = items.filter(function(it){ return it.json && it.json.name === archivoEsperado && it.json.id; });\nif (exactos.length > 1) {\n  throw new Error('ERROR_AMBIGUO_CIERRE_PROCESADOS: se encontraron ' + exactos.length + ' archivos llamados \"' + archivoEsperado + '\" en 03_PROCESADOS. Revisar manualmente.');\n}\nif (exactos.length === 1) {\n  return [{ json: { id: exactos[0].json.id, ya_en_procesados: true } }];\n}\nthrow new Error('ERROR_CIERRE_NO_LOCALIZADO: \"' + archivoEsperado + '\" no esta ni en 00_ENTRADA_CIERRES ni en 03_PROCESADOS. No se puede publicar oficialmente sin localizar el cierre original.');"}},{"id":"fdb452bb-e314-43c3-ba1b-2461253e686a","name":"CONSOLIDAR - Cierre resuelto","type":"n8n-nodes-base.code","typeVersion":2,"position":[4480,192],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"return [{ json: { cierre_file_id: $json.id, ya_en_procesados: $json.ya_en_procesados } }];"}},{"id":"28c455d1-ca52-47b0-bff3-e70018f82e2f","name":"IF - Cierre ya esta en PROCESADOS","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[4704,192],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"leftValue":"={{ $json.ya_en_procesados }}","operator":{"type":"boolean","operation":"true"},"rightValue":""}],"combinator":"and"}}},{"id":"0c66edbc-5336-48c2-8f47-98106d26cd1b","name":"LEER - Marker oficial local","type":"n8n-nodes-base.readWriteFile","typeVersion":1.1,"position":[5152,192],"parameters":{"operation":"read","fileSelector":"={{ $('ENTRADA (Execute Workflow Trigger)').item.json.ruta_marker }}","options":{}}},{"id":"4bb9f114-723e-4db2-95d7-9f29c58c4f3d","name":"MOVER - Cierre a 03_PROCESADOS","type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[4928,272],"parameters":{"resource":"file","operation":"move","fileId":{"__rl":true,"mode":"id","value":"={{ $json.cierre_file_id }}"},"driveId":{"__rl":true,"mode":"list","value":"My Drive"},"folderId":{"__rl":true,"mode":"id","value":"1BkNC6lnonMM7YeWDKck-TM8WTyY2BJJP"}},"credentials":{"googleDriveOAuth2Api":{"id":"aoEcEAFQQ38XcwZg","name":"Google Drive account"}}},{"id":"22ccffa9-5fab-405f-ade9-19b888fa1a4d","name":"SUBIR - Marker oficial a Drive (ultimo paso)","type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[5376,192],"parameters":{"resource":"file","operation":"upload","name":"={{ 'PROCESADO_' + $('ENTRADA (Execute Workflow Trigger)').item.json.sha256 + '.json' }}","driveId":{"__rl":true,"mode":"list","value":"My Drive"},"folderId":{"__rl":true,"mode":"id","value":"1i8wXRM-2yiH5N3SPOEd4eEqZnizCeCGu"},"options":{}},"credentials":{"googleDriveOAuth2Api":{"id":"aoEcEAFQQ38XcwZg","name":"Google Drive account"}}},{"id":"bcf06765-49e4-40b1-921d-07b5eb279482","name":"CONSTRUIR - Salida PUBLICADO (oficial)","type":"n8n-nodes-base.code","typeVersion":2,"position":[5600,192],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const t = $('ENTRADA (Execute Workflow Trigger)').first().json;\nreturn [{ json: {\n  fecha: t.fecha, sha256: t.sha256,\n  estado_publicacion: 'PUBLICADO_OFICIAL', publicado: true,\n  drive_entrada_file_id: $('CONSOLIDAR - Cierre resuelto').first().json.cierre_file_id,\n  drive_sap_file_id: $('CONSOLIDAR - SAP resuelto').first().json.sap_file_id,\n  drive_resultado_file_id: $('CONSOLIDAR - Resultado resuelto').first().json.resultado_file_id,\n  drive_marker_file_id: $json.id,\n  mensaje: 'Cierre publicado oficialmente en Drive: SAP + resultado + cierre movido a 03_PROCESADOS + marcador.',\n} }];"}},{"id":"b72b2eb5-0cdb-4f54-a285-7d8a45b86c91","name":"Sticky Note c2fbc6e9","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[2736,288],"parameters":{"content":"## TIQ V3 · 06B PUBLICACION OFICIAL · DRIVE -- FASE 11A.1 (REENTRANTE)\nSube a Drive lo que v3.publicacion ya publico localmente. Invocado UNA VEZ POR CIERRE (Execute Workflow, mode=each) desde el backend DEV, rama /publicar.\n\nREENTRANTE: antes de crear cualquier artefacto se BUSCA por nombre oficial exacto en su carpeta destino -- 0 coincidencias sube, 1 coincidencia reutiliza (nunca duplica), >1 coincidencias lanza ERROR_AMBIGUO y detiene la ejecucion sin tocar nada mas. Mismo criterio para SAP, RESULTADO y (via 00_ENTRADA_CIERRES/03_PROCESADOS) el CIERRE original. Un retry tras un fallo parcial retoma exactamente donde se corto, sin duplicar nada ya creado.\n\nFILE ID DEL CIERRE: se usa PRIORITARIAMENTE el drive_file_id que V3 ya detecto en INGESTA (Modulo 01, ver v3/ingesta.py::ejecutar_ingesta -- ahora propagado correctamente por v3/materializacion.py, FASE 11A.1). La busqueda por nombre exacto en 00_ENTRADA_CIERRES/03_PROCESADOS es una VERIFICACION/reconciliacion (cruza el id contra el nombre actual, detecta si ya fue movido en un retry previo), nunca el mecanismo principal de identificacion. Si el fileId de ingesta no coincide con el archivo actual -> ERROR_FILEID_INGESTA_NO_COINCIDE, se detiene sin mover nada.\n\nMARKER: sigue siendo el ultimo paso, sin excepcion -- si existe al inicio, YA_PUBLICADO inmediato sin tocar nada mas.\n\nReutiliza la credencial 'Google Drive account' (aoEcEAFQQ38XcwZg). No toca V2. FASE 11A.1: implementado y validado estructuralmente; SIN ejecutar contra Drive real ni carpetas productivas en esta fase.","color":4}}],
